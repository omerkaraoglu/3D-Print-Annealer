         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">MOC3052M - 6-Pin DIP Random-Phase Triac Driver Optocoupler (600 Volt Peak)</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>fg6m8v</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The MOC3051M, MOC3052M and MOC3053M consist of a GaAs infrared emitting diode optically coupled to a non-zero- crossing silicon bilateral AC switch (triac). These devices isolate low voltage logic from 115 VAC and 240 VAC lines to provide random phase control of high current triacs or thyristors. These devices feature greatly enhanced static dv/dt capability to ensure stable switching performance of inductive loads.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <pdf:Producer>Acrobat Distiller 18.0 (Windows)</pdf:Producer>
         <pdf:Keywords/>
         <xmpMM:DocumentID>uuid:20a0b5d5-0801-484a-bb91-2432f0f39260</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:d93434fa-f4d9-4ec6-ba7e-31b8ce992b0c</xmpMM:InstanceID>
      </rdf:Description>
